<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <ApplicationTitle>Reactor Counter (Uno)</ApplicationTitle>
    <ApplicationId>dev.reactor.unocounter</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <Nullable>enable</Nullable>

    <!-- HotReload pulls in the Uno dev-server client (Uno.WinUI.DevServer).
         Reactor's own hot reload rides on the standard .NET
         [assembly: MetadataUpdateHandler], and Uno's HotReloadAgent discovers
         and invokes every registered handler - so with this on, editing a
         Component.Render() body re-renders live through Uno's pipeline on the
         targets `dotnet watch` alone cannot reach (wasm, Android, iOS). -->
    <UnoFeatures>
      SkiaRenderer;
      HotReload;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Reactor.Uno\Reactor.Uno.csproj" />
  </ItemGroup>

</Project>
